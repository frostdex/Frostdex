# Vercel API function settings
HF_TOKEN=hf_your_hugging_face_read_token
FROSTWAVE_HF_VIDEO_SPACE_URL=https://upsampler-wan-2-2-14b-text-to-video.hf.space
FROSTWAVE_HF_MUSIC_SPACE_URL=https://ace-step-ace-step-v1-5.hf.space
# Optional comma-separated EVM wallet allowlist. Leave unset to allow any wallet to sign in.
# FROSTWAVE_ALLOWED_WALLETS=0xFirstPublicWalletAddress,0xSecondPublicWalletAddress
# FROSTWAVE_WALLETCONNECT_PROJECT_ID=your-reown-project-id

# Optional local Python backend settings
FROSTWAVE_BIND_HOST=127.0.0.1
FROSTWAVE_PORT=8000
FROSTWAVE_DATA_DIR=/var/lib/frostwave
FROSTWAVE_ALLOWED_ORIGINS=https://your-project.vercel.app

# Optional automatic removal of completed/failed videos; 0 keeps them indefinitely.
FROSTWAVE_VIDEO_RETENTION_DAYS=0
# Comma-separated EVM chain IDs; defaults to Ethereum, Optimism, Polygon, Base, and Arbitrum.
# FROSTWAVE_WALLETCONNECT_CHAINS=1,10,137,8453,42161
